if(DIAG_MODE STREQUAL "enabled")
    set(ENV{GGML_VBR_DIAG} 1)
else()
    set(ENV{GGML_VBR_DIAG} 0)
endif()
execute_process(COMMAND "${DIAG_PROGRAM}" "${DIAG_MODE}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE dump)
if(NOT result EQUAL 0 OR NOT output MATCHES "PASS:")
    message(FATAL_ERROR "recorder fixture failed: ${result}\n${output}\n${dump}")
endif()
if(DIAG_MODE STREQUAL "disabled")
    if(NOT dump STREQUAL "")
        message(FATAL_ERROR "disabled recorder produced output: ${dump}")
    endif()
    return()
endif()
foreach(marker "checkpoint_fixture_preserved" "[truncated]"
        "simulated_failure operation=cuMemSetAccess result=600" "VBR_DIAG_END\n")
    string(FIND "${dump}" "${marker}" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "missing marker: ${marker}")
    endif()
endforeach()
string(FIND "${dump}" "map_fixture=0\n" old_entry)
if(NOT old_entry EQUAL -1)
    message(FATAL_ERROR "old map entries were not overwritten")
endif()
string(REGEX MATCHALL "VBR_DIAG seq=[0-9]+" events "${dump}")
list(LENGTH events count)
if(NOT count EQUAL 258)
    message(FATAL_ERROR "expected 128 map + 128 pressure + 2 state events, got ${count}")
endif()
set(previous 0)
foreach(event IN LISTS events)
    string(REPLACE "VBR_DIAG seq=" "" sequence "${event}")
    if(NOT sequence GREATER previous)
        message(FATAL_ERROR "events not chronologically ordered: ${previous}, ${sequence}")
    endif()
    set(previous ${sequence})
endforeach()
